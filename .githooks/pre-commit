#!/bin/sh
# pre-commit: block secrets / personal paths in staged files
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "./tools/Test-PublishHygiene.ps1" -Scope Staged
  exit $?
fi

if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "./tools/Test-PublishHygiene.ps1" -Scope Staged
  exit $?
fi

if command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "./tools/Test-PublishHygiene.ps1" -Scope Staged
  exit $?
fi

echo "publish-hygiene: PowerShell not found; skip local hook (CI still runs)" >&2
exit 0
